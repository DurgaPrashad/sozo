{
  "openapi": "3.0.3",
  "info": {
    "title": "SOZO Research API",
    "version": "0.1.0",
    "description": "Evidence-first scientific literature discovery. No LLM synthesis, live MOMAR, MCP, OAuth, or arbitrary code execution is configured. Browser identity uses Sites sign-in; API clients use a SOZO bearer key and, on a private Site, the separate Sites service-access header."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "SozoKey": []
    }
  ],
