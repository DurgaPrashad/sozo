{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": ".sites-runtime/tests",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "noEmit": false
  },
  "include": [
    "tests/core.test.ts",
    "lib/science/*.ts",
    "tests/relevance.test.ts",
    "tests/companion.test.ts",
    "lib/companion/*.ts",
    "lib/auth/crypto.ts",
    "tests/claim-checks.test.ts",
    "tests/article-cache.test.ts",
    "tests/facebook.test.ts",
    "lib/auth/facebook.ts",
    "lib/platform/postgres-d1.ts",
    "db/schema.ts",
    "lib/auth/social.ts",
    "lib/auth/supabase.ts",
    "tests/supabase.test.ts",
    "lib/platform/diagnostics.ts",
    "tests/diagnostics.test.ts"
  ]
}
