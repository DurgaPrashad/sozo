# SOZO environment variables (reference; never put real values in this file).
# Fill in .env.vercel instead (ignored by git), then paste its lines into
# Vercel → Project → Settings → Environment Variables and redeploy.
# Local Cloudflare/Sites preview reads the server secrets from .dev.vars.

# ── Required on Vercel ────────────────────────────────────────────────
# Database: Supabase PostgreSQL. Use the *Transaction pooler* URI from
# Supabase → Connect (port 6543, IPv4). The direct db.<ref>.supabase.co host is
# IPv6-only and unreachable from Vercel. URL-encode special characters in the
# password (@ → %40). SOZO keeps its tables in a private `sozo` schema.
# Production deploys create and update the tables automatically.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Alternative to Supabase: Turso / libSQL (used only when DATABASE_URL is unset).
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=<turso-database-token>

# Google sign-in through Supabase Auth (Supabase → Project Settings → API).
# The publishable key is public by design; it is not a secret.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# Optional: your Google OAuth *Web* client ID. Shows Google's button on SOZO's
# own domain, so users never see the supabase.co address.
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# Workspace owner. This email always opens the owner workspace (password,
# Google or Facebook). The hash is a PBKDF2 verifier for the optional password
# form, never the password itself: npm run auth:hash-password
SOZO_WORKSPACE_EMAIL=<owner@example.com>
SOZO_WORKSPACE_PASSWORD_HASH=pbkdf2-sha256$100000$<salt-hex>$<derived-key-hex>

# SOZO scientist: conversation, research synthesis, voice and screenshots (Sarvam).
SARVAM_API_KEY=<sarvam-api-subscription-key>

# Optional second model: Meta Llama. Answers when Sarvam fails, or first with
# SOZO_CHAT_PROVIDER=meta. Any OpenAI-compatible Llama host works.
# META_LLAMA_API_KEY=<llama-api-key>
# META_LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# META_LLAMA_BASE_URL=https://api.llama.com/compat/v1
# SOZO_CHAT_PROVIDER=sarvam

# ── Facebook (Meta) login — optional ─────────────────────────────────
# From developers.facebook.com → your app → App settings → Basic. Keep the
# secret only here/in Vercel; never in browser code or chat.
FACEBOOK_APP_ID=<numeric-app-id>
FACEBOOK_APP_SECRET=<app-secret>
# FACEBOOK_GRAPH_VERSION=v26.0

# ── Who may sign in with Google or Facebook ──────────────────────────
# SOZO_WORKSPACE_EMAIL always opens the owner workspace. Listed emails, or
# anyone when SOZO_OPEN_SIGNUP=true, sign up with a private workspace. Open
# sign-up lets the public use the shared Sarvam quota.
# SOZO_ALLOWED_EMAILS=crew@example.com,ops@example.com
# SOZO_OPEN_SIGNUP=false

# ── Optional ──────────────────────────────────────────────────────────
# Extra reviewed public HTTPS hosts for custom OpenAPI connectors, comma-separated.
# Defaults: api.crossref.org, www.ebi.ac.uk. Never add private or loopback hosts.
# SOZO_CONNECTOR_HOSTS=

# ── Clients of SOZO (MOMAR backend, CLI) — set where the client runs ──
# SOZO_BASE_URL=https://sozo.momar.si
# SOZO_API_KEY=<create in the workspace: API & developers → API keys>
# SOZO_SITE_ACCESS_TOKEN=<only if Sites hosting is made private again>

# Auth smoke tests read SOZO_TEST_EMAIL and SOZO_TEST_PASSWORD only from the test process.
