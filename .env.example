# Only explicitly reviewed public HTTPS hosts; never add private or loopback hosts.
SOZO_CONNECTOR_HOSTS=
# CLI environment, configured in your terminal, never the browser bundle:
# SOZO_BASE_URL=http://localhost:5173
# SOZO_API_KEY=<create-in-the-workspace>
# SOZO_SITE_ACCESS_TOKEN=<private-Sites-service-access-token>

# Server-only workspace sign-in. Configure as Sites secrets; use ignored .dev.vars locally.
# SOZO_WORKSPACE_EMAIL=<workspace-account-email>
# SOZO_WORKSPACE_PASSWORD_HASH=pbkdf2-sha256$100000$<salt-hex>$<derived-key-hex>
# Auth smoke tests read SOZO_TEST_EMAIL and SOZO_TEST_PASSWORD only from the test process.
